# Two routes: LOCAL ("ollama" backend, no key needed beyond `ollama serve`)
# or CLOUD (pick the one matching your JUDGE_BACKEND). Only the key for
# your active backend needs a real value. Never commit this file.

# Cloud route "anthropic" (Claude API; or any Anthropic-compatible endpoint
# via ANTHROPIC_BASE_URL).
ANTHROPIC_API_KEY=your-key-here

# Cloud route "gemini" (AI Studio free tier).
GEMINI_API_KEY=your-key-here

# Cloud route "openai" (generic OpenAI-compatible slot: OpenAI, Groq,
# OpenRouter... - pair with OPENAI_BASE_URL in config.py).
OPENAI_API_KEY=your-key-here

# Only needed for Ollama Cloud (local serve needs no key).
OLLAMA_API_KEY=your-key-here
